Bootstrap: docker
From: ubuntu:22.04
Stage: build-cpp

%environment
	export DEBIAN_FRONTEND=noninteractive
	export PATH=/usr/local/bin:$PATH
	export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

%files
    ./libzmq /usr/local/src/libzmq

%post
	# Update apt; minimal interactive defaults
	apt-get update
	apt-get install -y dialog apt-utils
	echo 'debconf debconf/frontend select noninteractive' | debconf-set-selections
	# Install build dependencies
	apt-get install -y\
		build-essential\
        libnorm-dev\
        autoconf automake libtool pkg-config\
    # Clean apt cache
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/*
    # Install libzmq with norm support
    cd /usr/local/src/libzmq
    ./autogen.sh\
        && ./configure --disable-Werror --with-norm\
        && make\
        && make install

#####

Bootstrap: docker
From: rust:1.91
Stage: build-rust

%files from build-cpp
    /usr/local/lib /usr/local

%files
    ./rust-zmq /usr/local/src/rust-zmq
    ./openmls /usr/local/src/openmls
    ./mysgm /usr/local/src/mysgm

%post
	# Update apt; minimal interactive defaults
	apt-get update
	apt-get install -y dialog apt-utils
	echo 'debconf debconf/frontend select noninteractive' | debconf-set-selections
    # No dependencies needed here
    # Clean apt cache
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/*
    # Update dynamic linkage cache
    ldconfig
    # Build & install mysgm
    cd /usr/local/src/mysgm
    cargo install --path /usr/local/bin

#####

Bootstrap: docker
From: ubuntu:22.04
Stage: final

%files from build-cpp
    /usr/local/lib /usr/local

%files from build-rust
    /usr/local/bin /usr/local

%post
	# Update apt; minimal interactive defaults
	apt-get update
	apt-get install -y dialog apt-utils
	echo 'debconf debconf/frontend select noninteractive' | debconf-set-selections
	# Install runtime dependencies
	apt-get install -y\
        libnorm1
    # Clean apt cache
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/*
    # Update dynamic linkage cache
    ldconfig
